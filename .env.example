# Copia questo file in .env e inserisci i valori del TUO progetto Supabase
# (Dashboard > Project Settings > API). Poi esegui: npm run config
# Il file .env non va su GitHub (è in .gitignore).

# Project URL, es. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chiave PUBBLICA: "Publishable key" (sb_publishable_...) oppure la vecchia "anon" key.
# MAI la "Secret key" (sb_secret_...) né la "service_role" key.
SUPABASE_PUBLISHABLE_KEY=

# Indirizzo a cui portano i link delle email (conferma e nuova password).
# Produzione: https://cioscina.github.io/Programma-studio/
# Sviluppo:   http://localhost:3000/
# Se vuoto, l'app usa l'indirizzo della pagina aperta.
SITE_URL=
